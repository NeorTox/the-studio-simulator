{
  "name": "the-studio",
  "version": "4.51.0",
  "private": true,
  "description": "THE STUDIO — entertainment empire simulation",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:web": "node scripts/prepare-web.mjs",
    "android:init": "cap add android",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:sync": "npm run build:web && cap sync android && npm run android:prepare",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2"
  }
}
